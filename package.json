{
	"name": "danielturcich.com",
	"version": "1.0.0",
	"private": true,
	"description": "My website, a bio and portfolio site.",
	"author": {
		"name": "Daniel Turcich",
		"email": "packageJson@danielTurcich.com",
		"url": "https://danielTurcich.com"
	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:network": "vite --host",
		"build": "vite build --emptyOutDir && pnpm generate:404 && pnpm add:cname",
		"lint:fix": "oxlint --fix",
		"lint:check": "oxlint",
		"format:fix": "oxfmt",
		"format:check": "oxfmt --check",
		"type:check": "vue-tsc --noEmit",
		"checks": "pnpm lint:check && pnpm format:check ",
		"preview": "vite preview",
		"prepare": "husky",
		"add:cname": "cd dist && echo 'danielturcich.com' > CNAME",
		"generate:404": "cd dist && cp index.html 404.html",
		"knip": "knip",
		"analyze": "pnpm dlx vite-bundle-analyzer"
	},
	"dependencies": {
		"pinia": "^4.1.0",
		"vue": "^3.6.0-rc.14",
		"vue-router": "^5.5.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-legacy": "^8.2.4",
		"@vitejs/plugin-vue": "^6.0.10",
		"husky": "^9.1.7",
		"knip": "^6.45.1",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"postcss": "^8.5.32",
		"rollup-plugin-gzip": "^4.2.1",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vue-tsc": "^3.3.14"
	},
	"engines": {
		"node": "^26.1.0",
		"pnpm": "^12.16.1"
	},
	"engineStrict": true,
	"packageManager": "pnpm@12.16.1"
}
